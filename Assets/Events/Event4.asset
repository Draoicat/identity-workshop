  m_EditorClassIdentifier: Assembly-CSharp::Event
  eventText:
  - "Vous d\xE9ambulez dans les couloirs \xE9troits de la fac, "
  - "Quand vous remarquez au loin, la personne dont votre coeur est \xE9pris. "
  - 'Ses pupilles, d''un air sympathique, croisent les votres. Que faites-vous de
    cette occasion ? '
  eventSummary: "Votre crush semble ravi de vous croiser, \xE0 vous de d\xE9cider
    quelle facette de vous lui plairait le plus. "
  votingTime: 3
  solutions:
  - solution: "Vous allez lui parler, les yeux p\xE9tillants d'enthousiasme"
    supportingParties: 000000000200000003000000
  - solution: "Vous la saluez de loin, avec un sourir traduisant une g\xEAne mod\xE9r\xE9e"
    supportingParties: 01000000
  - solution: "Vous l'ignorez et faites demi-tour de mani\xE8re nonchalante et d\xE9tach\xE9e."
    supportingParties: 04000000
